{
  "entities": {
    "user": {
      "title": "User",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique ID of the user from Firebase Authentication."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
            "type": "string",
            "format": "uri",
            "description": "The URL of the user's profile picture."
        }
      },
      "required": ["uid", "email"]
    },
    "task": {
      "title": "Task",
      "description": "A task to be completed in the factory.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this task."
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "doneAt": {
          "type": "string",
          "format": "date-time"
        },
        "division": {
          "type": "string",
          "enum": ["Operations", "Processing", "Production", "Maintenance", "Logistics"]
        },
        "impact": {
          "type": "string",
          "enum": ["High", "Medium", "Low"]
        },
        "order": {
            "type": "number",
            "description": "The display order of the task."
        }
      },
      "required": ["userId", "name", "deadline", "createdAt", "division", "impact"]
    },
    "division": {
        "title": "Division",
        "description": "A department or division within the factory.",
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "description": "The name of the division."
            }
        },
        "required": ["name"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/task"
      },
      "description": "Stores individual task documents."
    },
    "/users/{userId}/divisions/{divisionId}": {
        "schema": {
            "$ref": "#/entities/division"
        },
        "description": "Stores the custom divisions created by a user."
    }
  }
}
